{
  "name": "@dsh-one/dsh-llm-provider",
  "version": "0.1.0-alpha.3",
  "description": "给 dsh 提供 LLM 服务的插件：把内置 llm-pi-ai / llm-deepseek / 模型选择器 / Models 设置页换成自维护版本，跟进 @earendil-works/pi-ai 上游新模型，并提供额度/余额查询与 Provider 配置界面",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "llm",
    "llm-provider",
    "pi-ai"
  ],
  "homepage": "https://github.com/imchangchang/dsh-llm-provider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imchangchang/dsh-llm-provider.git"
  },
  "bugs": {
    "url": "https://github.com/imchangchang/dsh-llm-provider/issues"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "npm run build",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node test/routes.mjs && node test/credential-check.mjs && node test/cordis-patch.mjs && node test/pi-ai-probe.mjs && node test/provider-presets.mjs && node test/vendor-status.mjs && node test/client-smoke.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
